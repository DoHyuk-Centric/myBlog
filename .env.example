# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋하지 않습니다.

# Supabase 프로젝트 설정 > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 공공데이터포털 특일 정보 서비스 인증키
# supabase/functions/get-holidays 에서 사용하며, 브라우저로 내려가지 않습니다.
# 로컬 함수 실행 시에만 필요하고, 배포 환경에는 아래 명령으로 등록합니다.
#   supabase secrets set HOLIDAY_KEY=...
HOLIDAY_KEY=
